# ---------------------------------------------------------------------------
# Almanac configuration. Copy to .env and fill in. NEVER commit .env.
# Defaults to Signal — pair by QR and it self-configures (see docs/SIGNAL.md).
# ---------------------------------------------------------------------------

# Postgres (local container; values are arbitrary)
POSTGRES_DB=almanac
POSTGRES_USER=almanac
POSTGRES_PASSWORD=change-me

# pgcrypto key for the encrypted secrets table.  openssl rand -hex 32
ALMANAC_SECRET_KEY=change-me-32-bytes-hex

# --- LLM (OpenAI-compatible: OpenRouter, vLLM, …) ---
LLM_BASE_URL=https://openrouter.ai/api      # NOTE: no /v1 — the code appends it
LLM_MODEL=openai/gpt-4o-mini                # any tool-calling model
LLM_API_KEY=sk-or-your-openrouter-key

# --- Chat: Signal (default) ---
# Pair the bundled signal-cli sidecar to your Signal by QR (docs/SIGNAL.md) and
# you're done: Almanac auto-detects your number and auto-creates a private
# "Almanac" group it talks in. Nothing below is required.
CHANNEL=signal
# Optional overrides:
# SIGNAL_NUMBER=+4712345678     # auto-detected from the linked account if blank
# SIGNAL_GROUP_NAME=Almanac     # the group it creates / reuses
# SIGNAL_GROUP_ID=              # pin a specific group id (else auto)
# ALLOWED_CHAT_IDS=4712345678   # extra lock-down (digits, no '+'); the group already scopes it

# --- Embeddings (optional; semantic note search). OpenRouter has none — leave
#     blank for keyword search, or point at a local embeddings server. ---
EMBED_BASE_URL=
EMBED_MODEL=BAAI/bge-large-en-v1.5
EMBED_API_KEY=not-needed
EMBED_DIM=1024

# --- Bundled sidecars (leave as-is) ---
SEARCH_BASE_URL=http://searxng:8080
BROWSER_BASE_URL=http://browser:3000
OPENCODE_BASE_URL=http://opencode:5000

# --- Optional integrations ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GITHUB_TOKEN=

# Team mode: several people, one shared instance, individual DMs to a dedicated
# number (not QR/group). See docs/SIGNAL.md → Team.
TEAM_MODE=off

# --- Telegram (only if CHANNEL=telegram) ---
# TELEGRAM_TOKEN=123456:ABC-from-@BotFather
