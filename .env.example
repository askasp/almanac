# ---------------------------------------------------------------------------
# Almanac configuration. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Postgres
POSTGRES_DB=almanac
POSTGRES_USER=almanac
POSTGRES_PASSWORD=change-me-postgres

# Symmetric key used by pgcrypto to encrypt the `secrets` table.
# Generate one: openssl rand -hex 32
ALMANAC_SECRET_KEY=change-me-32-bytes-hex

# Telegram bot token from @BotFather
TELEGRAM_TOKEN=123456:ABC-your-bot-token

# Self-hosted LLM (vLLM, OpenAI-compatible). Runs on your GPU host.
# Reachable from the db container (use host.docker.internal or a LAN IP).
LLM_BASE_URL=http://host.docker.internal:8000
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_API_KEY=not-needed

# Embeddings (OpenAI-compatible: second vLLM --task embed, or HF TEI).
EMBED_BASE_URL=http://host.docker.internal:8001
EMBED_MODEL=BAAI/bge-large-en-v1.5
EMBED_API_KEY=not-needed
# Must match the embedding model's output dimension (bge-large = 1024).
EMBED_DIM=1024

# Web search backend. Default: the bundled SearXNG service.
SEARCH_BASE_URL=http://searxng:8080

# Browser sidecar (Playwright). Bundled service.
BROWSER_BASE_URL=http://browser:3000

# opencode coding sidecar. Bundled service. Uses LLM_BASE_URL/LLM_MODEL above.
OPENCODE_BASE_URL=http://opencode:5000

# Gmail (optional; for the daily summary). From a Google Cloud OAuth client.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
